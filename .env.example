# ─────────────────────────────────────────────────────────────────────
# SMCA Configuration Template
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file to git.
# ─────────────────────────────────────────────────────────────────────

# Flask secret key — any long random string (used for sessions/cookies)
SECRET_KEY=change-this-to-any-long-random-string

# Database — leave as-is for SQLite (auto-created on first run)
DATABASE_URL=sqlite:///instance/smca_demo.db

# ─── TikTok Developer App ─────────────────────────────────────────────
# Get these from https://developers.tiktok.com → your app → App Info

TIKTOK_CLIENT_KEY=your_client_key_here
TIKTOK_CLIENT_SECRET=your_client_secret_here

# Redirect URI — must match EXACTLY what you entered in TikTok Developer Portal
# Format: https://YOUR-NGROK-DOMAIN/auth/callback
TIKTOK_REDIRECT_URI=https://your-ngrok-domain.ngrok-free.app/auth/callback

# ─── Optional: Proxy for regions where TikTok API is blocked ──────────
# If you get "Failed to resolve open.tiktokapis.com", enable a VPN or
# set your proxy address here (e.g. from Clash, V2Ray, Shadowsocks):
# HTTPS_PROXY=http://127.0.0.1:1080
